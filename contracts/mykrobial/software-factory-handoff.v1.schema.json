{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mykrobial.org/schemas/software-factory-handoff.v1.schema.json",
  "title": "Harness to Software Factory source/runtime handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "handoff_id", "factory_id", "task_capsule_id", "work_item_id", "prh_stage",
    "frozen_prediction_sha256", "built_artifact_sha256", "proof_level", "next_action",
    "blockers", "execution_authorized", "deployment_authorized", "handoff_sha256"
  ],
  "properties": {
    "schema": { "const": "mykrobial.software-factory.handoff.v1" },
    "handoff_id": { "$ref": "harness-parity.v1.schema.json#/$defs/identifier" },
    "factory_id": { "enum": ["legacy_four_gate", "super_simple_software_factory", "unresolved"] },
    "task_capsule_id": { "$ref": "harness-parity.v1.schema.json#/$defs/identifier" },
    "work_item_id": { "$ref": "harness-parity.v1.schema.json#/$defs/identifier" },
    "prh_stage": { "enum": ["Abstract", "Extract", "Interact", "Act", "React", "Counteract", "Protract", "Enact", "Transact"] },
    "frozen_prediction_sha256": { "$ref": "harness-parity.v1.schema.json#/$defs/sha256" },
    "built_artifact_sha256": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "harness-parity.v1.schema.json#/$defs/sha256" } },
    "proof_level": { "enum": ["designed", "source_built", "source_verified", "runtime_verified", "deployed_verified"] },
    "next_action": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "blockers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^typed_blocker:[a-z0-9_:-]+$" } },
    "execution_authorized": { "const": false },
    "deployment_authorized": { "const": false },
    "handoff_sha256": { "$ref": "harness-parity.v1.schema.json#/$defs/sha256" }
  }
}
