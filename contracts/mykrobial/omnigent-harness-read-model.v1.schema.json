{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mykrobial.org/schemas/omnigent-harness-read-model.v1.schema.json",
  "title": "OmniGent read model for either Mykrobial harness generation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "generated_at", "task_capsule_id", "harness_generation", "source_identity",
    "loadout_id", "component_manifest_sha256", "behavior_projection_sha256", "scientific_posture",
    "route", "trace", "replay", "rollback", "factory", "proof_level", "end_user_acceptance", "non_claims"
  ],
  "properties": {
    "schema": { "const": "mykrobial.omnigent.harness-read-model.v1" },
    "generated_at": { "$ref": "harness-parity.v1.schema.json#/$defs/timestamp" },
    "task_capsule_id": { "$ref": "harness-parity.v1.schema.json#/$defs/identifier" },
    "harness_generation": { "$ref": "harness-parity.v1.schema.json#/$defs/generation" },
    "source_identity": { "$ref": "harness-parity.v1.schema.json#/$defs/sourceIdentity" },
    "loadout_id": { "$ref": "harness-parity.v1.schema.json#/$defs/identifier" },
    "component_manifest_sha256": { "$ref": "harness-parity.v1.schema.json#/$defs/sha256" },
    "behavior_projection_sha256": { "$ref": "harness-parity.v1.schema.json#/$defs/sha256" },
    "scientific_posture": { "enum": ["base", "retrodict_default", "retrodict_simulator_escalated", "retrodict_novelty_escape"] },
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "requested_model", "routed_model", "served_model", "provider", "receipt_sha256"],
      "properties": {
        "state": { "enum": ["not_requested", "prepared", "served_unverified", "served_verified", "blocked"] },
        "requested_model": { "type": ["string", "null"], "maxLength": 128 },
        "routed_model": { "type": ["string", "null"], "maxLength": 128 },
        "served_model": { "type": ["string", "null"], "maxLength": 128 },
        "provider": { "type": ["string", "null"], "maxLength": 128 },
        "receipt_sha256": { "anyOf": [{ "$ref": "harness-parity.v1.schema.json#/$defs/sha256" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "not_requested" } }, "required": ["state"] },
          "then": { "properties": { "requested_model": { "const": null }, "routed_model": { "const": null }, "served_model": { "const": null }, "provider": { "const": null }, "receipt_sha256": { "const": null } } }
        },
        {
          "if": { "properties": { "state": { "const": "prepared" } }, "required": ["state"] },
          "then": { "properties": { "requested_model": { "type": "string", "maxLength": 128 }, "routed_model": { "const": null }, "served_model": { "const": null }, "provider": { "const": null }, "receipt_sha256": { "const": null } } }
        },
        {
          "if": { "properties": { "state": { "enum": ["served_unverified", "served_verified"] } }, "required": ["state"] },
          "then": { "properties": { "requested_model": { "type": "string", "maxLength": 128 }, "routed_model": { "type": "string", "maxLength": 128 }, "served_model": { "type": "string", "maxLength": 128 }, "provider": { "type": "string", "maxLength": 128 } } }
        },
        {
          "if": { "properties": { "state": { "const": "served_verified" } }, "required": ["state"] },
          "then": { "properties": { "receipt_sha256": { "$ref": "harness-parity.v1.schema.json#/$defs/sha256" } }, "required": ["receipt_sha256"] }
        }
      ]
    },
    "trace": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "intent_count", "canonical_append_receipt_sha256", "blocker"],
      "properties": {
        "state": { "enum": ["intent_only", "queued", "append_verified", "blocked"] },
        "intent_count": { "type": "integer", "minimum": 0 },
        "canonical_append_receipt_sha256": { "anyOf": [{ "$ref": "harness-parity.v1.schema.json#/$defs/sha256" }, { "type": "null" }] },
        "blocker": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^typed_blocker:[a-z0-9_:-]+$" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "append_verified" } }, "required": ["state"] },
          "then": { "properties": { "canonical_append_receipt_sha256": { "$ref": "harness-parity.v1.schema.json#/$defs/sha256" } }, "required": ["canonical_append_receipt_sha256"] }
        },
        {
          "if": { "properties": { "state": { "enum": ["intent_only", "queued", "blocked"] } }, "required": ["state"] },
          "then": { "properties": { "canonical_append_receipt_sha256": { "const": null } } }
        },
        {
          "if": { "properties": { "state": { "const": "blocked" } }, "required": ["state"] },
          "then": { "properties": { "blocker": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^typed_blocker:[a-z0-9_:-]+$" } }, "required": ["blocker"] }
        },
        {
          "if": { "properties": { "state": { "enum": ["intent_only", "queued", "append_verified"] } }, "required": ["state"] },
          "then": { "properties": { "blocker": { "const": null } } }
        }
      ]
    },
    "replay": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "receipt_sha256"],
      "properties": {
        "state": { "enum": ["available", "verified", "blocked"] },
        "receipt_sha256": { "anyOf": [{ "$ref": "harness-parity.v1.schema.json#/$defs/sha256" }, { "type": "null" }] }
      },
      "allOf": [{
        "if": { "properties": { "state": { "const": "verified" } }, "required": ["state"] },
        "then": { "properties": { "receipt_sha256": { "$ref": "harness-parity.v1.schema.json#/$defs/sha256" } }, "required": ["receipt_sha256"] }
      }]
    },
    "rollback": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "receipt_sha256"],
      "properties": {
        "state": { "enum": ["declared", "rehearsed", "verified", "blocked"] },
        "receipt_sha256": { "anyOf": [{ "$ref": "harness-parity.v1.schema.json#/$defs/sha256" }, { "type": "null" }] }
      },
      "allOf": [{
        "if": { "properties": { "state": { "enum": ["rehearsed", "verified"] } }, "required": ["state"] },
        "then": { "properties": { "receipt_sha256": { "$ref": "harness-parity.v1.schema.json#/$defs/sha256" } }, "required": ["receipt_sha256"] }
      }]
    },
    "factory": {
      "type": "object", "additionalProperties": false,
      "required": ["factory_id", "integration_state", "prh_stage", "work_item_id", "handoff_sha256"],
      "properties": {
        "factory_id": { "enum": ["legacy_four_gate", "super_simple_software_factory", "unresolved"] },
        "integration_state": { "enum": ["contract_only", "source_wired", "runtime_verified", "blocked"] },
        "prh_stage": { "enum": ["Abstract", "Extract", "Interact", "Act", "React", "Counteract", "Protract", "Enact", "Transact"] },
        "work_item_id": { "$ref": "harness-parity.v1.schema.json#/$defs/identifier" },
        "handoff_sha256": { "$ref": "harness-parity.v1.schema.json#/$defs/sha256" }
      }
    },
    "proof_level": { "enum": ["designed", "source_built", "source_verified", "runtime_verified", "deployed_verified"] },
    "end_user_acceptance": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["step_id", "description", "state", "receipt_sha256"],
        "properties": {
          "step_id": { "$ref": "harness-parity.v1.schema.json#/$defs/identifier" },
          "description": { "type": "string", "minLength": 1, "maxLength": 512 },
          "state": { "enum": ["pending", "passed", "failed", "blocked"] },
          "receipt_sha256": { "anyOf": [{ "$ref": "harness-parity.v1.schema.json#/$defs/sha256" }, { "type": "null" }] }
        },
        "allOf": [{
          "if": { "properties": { "state": { "const": "passed" } }, "required": ["state"] },
          "then": { "properties": { "receipt_sha256": { "$ref": "harness-parity.v1.schema.json#/$defs/sha256" } }, "required": ["receipt_sha256"] }
        }]
      }
    },
    "non_claims": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
  },
  "allOf": [
    {
      "if": { "properties": { "proof_level": { "enum": ["runtime_verified", "deployed_verified"] } }, "required": ["proof_level"] },
      "then": {
        "properties": {
          "route": { "properties": { "state": { "const": "served_verified" } }, "required": ["state"] },
          "trace": { "properties": { "state": { "const": "append_verified" } }, "required": ["state"] },
          "replay": { "properties": { "state": { "const": "verified" } }, "required": ["state"] },
          "rollback": { "properties": { "state": { "const": "verified" } }, "required": ["state"] },
          "factory": { "properties": { "integration_state": { "const": "runtime_verified" } }, "required": ["integration_state"] }
        },
        "required": ["route", "trace", "replay", "rollback", "factory"]
      }
    },
    {
      "if": { "properties": { "proof_level": { "const": "deployed_verified" } }, "required": ["proof_level"] },
      "then": {
        "properties": {
          "end_user_acceptance": { "items": { "properties": { "state": { "const": "passed" } }, "required": ["state"] } }
        },
        "required": ["end_user_acceptance"]
      }
    }
  ]
}
